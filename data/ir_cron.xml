<odoo>

    <record id="ir_cron_send_daily_boletas_rc" model="ir.cron">
        <field name="name">SUNAT - Enviar Resumen Diario Boletas POS</field>
        <field name="model_id" ref="model_sunat_cron_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_daily_boletas_rc()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>

        <!--
            Odoo almacena nextcall en UTC.
            04:00 UTC = 23:00 hora Perú (UTC-5).

            Se calcula siempre la próxima ocurrencia de las 04:00 UTC.
        -->
        <field name="nextcall"
               eval="(DateTime.utcnow().replace(hour=4, minute=0, second=0, microsecond=0) + timedelta(days=1 if DateTime.utcnow().hour >= 4 else 0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>

    <record id="ir_cron_check_pending_tickets" model="ir.cron">
        <field name="name">SUNAT - Consultar Tickets RC POS</field>
        <field name="model_id" ref="model_sunat_cron_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_pending_tickets()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_retry_pending_invoices" model="ir.cron">
        <field name="name">SUNAT - Verificar y Reintentar Facturas POS</field>
        <field name="model_id" ref="model_sunat_cron_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_retry_pending_invoices()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>