<odoo>
    <record id="view_pos_order_form_sunat_documents" model="ir.ui.view">
        <field name="name">pos.order.form.sunat.documents</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <!-- =====================================================
                     CAMPOS NECESARIOS PARA CONTROLAR LA VISIBILIDAD
                     DEL BOTÓN DE BAJA SUNAT
                ====================================================== -->
                <field name="sunat_document_type" invisible="1"/>
                <field name="sunat_state" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="sunat_cancel_rc_batch_id" invisible="1"/>

                <!-- Campo propio de pos_sunat_direct para controlar el botón de baja -->
                <field name="sunat_can_prepare_cancel" invisible="1"/>

                <div class="btn-group">
                    <button type="button"
                            class="btn btn-primary dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Documentos SUNAT
                    </button>

                    <div class="dropdown-menu">

                        <!-- NOTA DE CRÉDITO -->
                        <button name="action_open_credit_note_wizard"
                                type="object"
                                class="dropdown-item">
                            Crear Nota de Crédito
                        </button>

                        <!-- =================================================
                             BAJA DE BOLETA SUNAT
                             Solo aparece cuando:
                             - Es Boleta
                             - SUNAT la aceptó
                             - Está cancelada o anulada en Odoo
                             - No es una reversa
                             - Todavía no tiene RC de baja
                        ================================================== -->
                        <button name="action_create_sunat_cancel_rc"
                                type="object"
                                class="dropdown-item"
                                invisible="not sunat_can_prepare_cancel">
                            Preparar baja SUNAT
                        </button>
                        <!-- PRÓXIMAMENTE -->
                        <button type="button"
                                class="dropdown-item disabled">
                            Crear Nota de Débito
                        </button>

                        <button type="button"
                                class="dropdown-item disabled">
                            Crear Guía de Remisión
                        </button>

                    </div>
                </div>

            </xpath>

        </field>
    </record>
</odoo>